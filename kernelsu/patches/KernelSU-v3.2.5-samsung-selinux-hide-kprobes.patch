+static int ksu_selinux_hide_context_to_sid(const char *context, size_t length, u32 *sid)
+{
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+    return security_context_to_sid_with_policy(backup_sepolicy, context, length, sid, SECSID_NULL, GFP_ATOMIC);
+#else
