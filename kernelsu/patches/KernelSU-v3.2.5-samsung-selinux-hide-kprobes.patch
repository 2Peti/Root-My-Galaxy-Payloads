+static bool ksu_selinux_hide_space(char c)
+{
+    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
+}
+
+static int ksu_selinux_hide_next_token(char **cursor, char **token)
+{
+    while (ksu_selinux_hide_space(**cursor))
+        (*cursor)++;
+    if (!**cursor)
+        return -EINVAL;
+    *token = *cursor;
+    while (**cursor && !ksu_selinux_hide_space(**cursor))
+        (*cursor)++;
+    if (**cursor)
+        *(*cursor)++ = '\0';
+    return 0;
+}
+
+static int ksu_selinux_hide_access_result(struct ksu_selinux_hide_write_probe_data *data)
+{
+    char *cursor = data->request;
+    char *source, *target, *class_name;
+    u32 source_sid, target_sid;
+    u16 tclass;
+    struct av_decision avd;
+    int ret;
+
+    ret = ksu_selinux_hide_next_token(&cursor, &source);
+    if (ret)
+        return ret;
+    ret = ksu_selinux_hide_next_token(&cursor, &target);
+    if (ret)
+        return ret;
+    ret = ksu_selinux_hide_next_token(&cursor, &class_name);
+    if (ret)
+        return ret;
+    ret = kstrtou16(class_name, 10, &tclass);
+    if (ret)
+        return ret;
+
+    ret = ksu_selinux_hide_context_to_sid(source, strlen(source), &source_sid);
+    if (ret)
+        return ret;
+    ret = ksu_selinux_hide_context_to_sid(target, strlen(target), &target_sid);
+    if (ret)
+        return ret;
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+    if (!security_compute_av_user_with_policy)
+        return -ENOSYS;
+    security_compute_av_user_with_policy(backup_sepolicy, source_sid, target_sid, tclass, &avd);
+#else
+    security_compute_av_user(&fake_state, source_sid, target_sid, tclass, &avd);
+#endif
+
+    return scnprintf(data->header.buf, SIMPLE_TRANSACTION_LIMIT, "%x %x %x %x %u %x", avd.allowed, 0xffffffff,
+                     avd.auditallow, avd.auditdeny, avd.seqno, avd.flags);
+}
+
+static int ksu_selinux_hide_write_probe_entry(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+    struct ksu_selinux_hide_write_probe_data *data = (struct ksu_selinux_hide_write_probe_data *)ri->data;
+
+    if (!READ_ONCE(ksu_selinux_hide_enabled) || current_uid().val < 10000)
+        return 1;
+
+    data->header.file = (struct file *)(unsigned long)regs->regs[0];
+    data->header.buf = (char *)(unsigned long)regs->regs[1];
+    data->header.size = (size_t)regs->regs[2];
+    if (!data->header.file || !data->header.buf)
+        return 1;
+    data->header.ino = file_inode(data->header.file)->i_ino;
+    if (data->header.ino != SEL_CONTEXT && data->header.ino != SEL_ACCESS)
+        return 1;
+
+    data->header.oversized = data->header.size >= sizeof(data->request);
+    if (!data->header.oversized) {
+        memcpy(data->request, data->header.buf, data->header.size);
+        data->request[data->header.size] = '\0';
+    }
+    return 0;
+}
+
+static int ksu_selinux_hide_write_probe_return(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+    struct ksu_selinux_hide_write_probe_data *data = (struct ksu_selinux_hide_write_probe_data *)ri->data;
+    ssize_t ret = regs_return_value(regs);
+
+    if (ret < 0 || !data->header.buf)
+        return 0;
+    if (data->header.oversized) {
+        regs->regs[0] = (unsigned long)-E2BIG;
+        return 0;
+    }
+
+    if (data->header.ino == SEL_CONTEXT) {
+        u32 sid;
+        int check = ksu_selinux_hide_context_to_sid(data->request, data->header.size, &sid);
+        if (check)
+            regs->regs[0] = (unsigned long)check;
+    } else if (data->header.ino == SEL_ACCESS) {
+        int check = ksu_selinux_hide_access_result(data);
+        regs->regs[0] = (unsigned long)check;
+    }
+    return 0;
+}
 
+static int ksu_selinux_hide_status_probe_entry(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+    struct ksu_selinux_hide_status_probe_data *data = (struct ksu_selinux_hide_status_probe_data *)ri->data;
+
+    if (!READ_ONCE(ksu_selinux_hide_enabled) || current_uid().val < 10000)
+        return 1;
+    data->file = (struct file *)(unsigned long)regs->regs[1];
+    return data->file ? 0 : 1;
+}
+
+static int ksu_selinux_hide_status_probe_return(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+    struct ksu_selinux_hide_status_probe_data *data = (struct ksu_selinux_hide_status_probe_data *)ri->data;
+
+    if (!regs_return_value(regs) && data->file && READ_ONCE(fake_status))
+        data->file->private_data = READ_ONCE(fake_status);
+    return 0;
+}
