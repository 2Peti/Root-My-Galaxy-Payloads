+#ifdef CONFIG_KSU_SAMSUNG_NO_PATCH_TEXT
+static int ksu_selinux_hide_register_probes(void)
+{
+    const struct file_operations *status_ops;
+    unsigned int i, j;
+    int ret;
+
+    context_write = &selinux_write_op[SEL_CONTEXT];
+    access_write = &selinux_write_op[SEL_ACCESS];
+    if (!*context_write || !*access_write)
+        return -ENOSYS;
+
+    for (i = 0; i < 2; i++) {
+        write_op_fn target = i ? *access_write : *context_write;
+        struct kretprobe *probe;
+        bool duplicate = false;
+
+        for (j = 0; j < selinux_hide_write_probe_count; j++) {
+            if (selinux_hide_write_probes[j].kp.addr == (kprobe_opcode_t *)(unsigned long)target) {
+                duplicate = true;
+                break;
+            }
+        }
+        if (duplicate)
+            continue;
+
+        probe = &selinux_hide_write_probes[selinux_hide_write_probe_count];
+        memset(probe, 0, sizeof(*probe));
+        probe->kp.addr = (kprobe_opcode_t *)(unsigned long)target;
+        probe->entry_handler = ksu_selinux_hide_write_probe_entry;
+        probe->handler = ksu_selinux_hide_write_probe_return;
+        probe->data_size = sizeof(struct ksu_selinux_hide_write_probe_data);
+        probe->maxactive = 64;
+        ret = register_kretprobe(probe);
+        if (ret)
+            goto fail;
+        selinux_hide_write_probe_count++;
+    }
+
+    status_ops = (const struct file_operations *)find_kernel_symbol_exact("sel_handle_status_ops");
+    if (!status_ops || !status_ops->open) {
+        ret = -ENOSYS;
+        goto fail;
+    }
+    memset(&selinux_hide_status_probe, 0, sizeof(selinux_hide_status_probe));
+    selinux_hide_status_probe.kp.addr = (kprobe_opcode_t *)(unsigned long)status_ops->open;
+    selinux_hide_status_probe.entry_handler = ksu_selinux_hide_status_probe_entry;
+    selinux_hide_status_probe.handler = ksu_selinux_hide_status_probe_return;
+    selinux_hide_status_probe.data_size = sizeof(struct ksu_selinux_hide_status_probe_data);
+    selinux_hide_status_probe.maxactive = 64;
+    ret = register_kretprobe(&selinux_hide_status_probe);
+    if (ret)
+        goto fail;
+    selinux_hide_status_probe_registered = true;
+
+    pr_info("selinux_hide: registered Samsung kprobe fallback\n");
+    return 0;
+
+fail:
+    ksu_selinux_hide_unhook();
+    return ret;
+}
+#endif
